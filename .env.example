# ==============================================================================
# Learnova AI LMS - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in backend/ or frontend/ for local development,
# or configure these environment variables in your cloud provider dashboard
# (e.g. Render for backend, Vercel for frontend).
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (.NET 10 Web API)
# ------------------------------------------------------------------------------

# MongoDB Connection String (Atlas cloud cluster or local instance):
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.yourcluster.mongodb.net/?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=AI_LMS

# JWT Configuration (Must be at least 32 characters in production):
JWT_SECRET=Learnova_Enterprise_Secret_Key_For_JWT_Authentication_2026_Secure!
Jwt__Issuer=AI-LMS
Jwt__Audience=AI-LMS-Users

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/):
Gemini__ApiKey=YOUR_GEMINI_API_KEY
Gemini__Model=gemini-1.5-flash

# Admin User Setup (Optional: overrides default admin on first startup seed):
ADMIN_EMAIL=admin@learnova.ai
ADMIN_PASSWORD=YourSecureAdminPassword123!

# ASP.NET Core Runtime Environment (Production or Development):
ASPNETCORE_ENVIRONMENT=Production

# Allowed Frontend URLs for CORS (comma-separated if multiple):
FRONTEND_URL=http://localhost:5173,https://your-frontend-domain.vercel.app

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------

# Base URL pointing to your backend API:
# Local dev: http://localhost:5291/api
# Production: https://your-backend-api.onrender.com/api
VITE_API_URL=http://localhost:5291/api
